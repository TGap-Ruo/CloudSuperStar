# 复制为 .env 或写入 systemd 的 EnvironmentFile（/etc/chaoxing/chaoxing.env）
# 配合 config.yaml 中的 password_env / key_env 使用，避免密码明文写在配置里

CHAOXING_MAIN_PASSWORD=你的学习通密码
CHAOXING_SECOND_PASSWORD=第二个账号的密码

# 服务端运行参数
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1
TZ=Asia/Shanghai

# 可选：数据目录（优先级高于 config.yaml 的 server.data_dir）
# CHAOXING_DATA_DIR=/var/lib/chaoxing
